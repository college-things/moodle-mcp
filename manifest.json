{
  "manifest_version": "0.3",
  "name": "moodle-mcp",
  "display_name": "Moodle",
  "version": "1.1.0",
  "description": "Connect to any Moodle site: courses, grades, deadlines, course files, forums, quiz results and homework upload.",
  "author": {
    "name": "moodle-mcp contributors"
  },
  "license": "ISC",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ]
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=22.0.0"
    }
  }
}
